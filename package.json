{
  "name": "six-commits-from-linus",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Trace public GitHub contribution routes to notable open-source developers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:index": "node --import tsx scripts/build-famous-index.ts",
    "validate:famous": "node --import tsx scripts/validate-famous-devs.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "^6.0.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript-eslint": "latest"
  }
}
